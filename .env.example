# Copy this file to .env (it is ignored by git) and set the values. Docker Compose reads it automatically.

# Secret that signs the JWTs. It must be the same one auth-service and Kong use, and at least 32 characters.
JWT_SECRET=

# Catalog Service -> MongoDB. Use the user and password of the "mongo" service of docker-compose.yml.
MONGODB_URI=mongodb://USER:PASSWORD@mongo:27017/streamhub?authSource=admin

# Optional local overrides. Useful when another local process already uses 8081.
# AUTH_SERVICE_PORT=18081

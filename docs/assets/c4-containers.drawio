<mxfile host="app.diagrams.net">
  <diagram id="c4-containers" name="C4 Level 2 - Containers">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="StreamHub VOD - Container Diagram (C4 Level 2)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="-20" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="boundary" value="StreamHub VOD Platform [System]" style="rounded=0;dashed=1;fillColor=none;strokeColor=#444444;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="20" width="1020" height="830" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Watches content, sends playback pings and rates titles (Web, Mobile, SmartTV)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="170" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;[Kong]&lt;br&gt;&lt;br&gt;Single entry point. Validates JWT, routes requests, adds X-Correlation-ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="200" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;Auth &amp;amp; Profile Service&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;br&gt;Master accounts and family subprofiles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="50" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="catalog" value="&lt;b&gt;Catalog &amp;amp; Home Service&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;br&gt;Serves the Home screen and catalog metadata" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="250" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="telemetry" value="&lt;b&gt;Telemetry Service&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;br&gt;Receives pings and likes, replies 202 Accepted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="560" width="200" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="authdb" value="&lt;b&gt;Auth DB&lt;/b&gt;&lt;br&gt;[PostgreSQL]&lt;br&gt;Accounts and subprofiles" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="40" width="180" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="&lt;b&gt;Cache&lt;/b&gt;&lt;br&gt;[Redis]&lt;br&gt;Precomputed Home view and Continue Watching" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="230" width="180" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="mongo" value="&lt;b&gt;Catalog DB&lt;/b&gt;&lt;br&gt;[MongoDB]&lt;br&gt;Movies and series metadata" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="400" width="180" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="broker" value="&lt;b&gt;Message Broker&lt;/b&gt;&lt;br&gt;[RabbitMQ]&lt;br&gt;&lt;br&gt;Telemetry and interaction queues" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="560" width="160" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;Recommendation Worker&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;br&gt;Processes events in background and updates the cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="560" width="190" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="obs" value="&lt;b&gt;Observability Stack&lt;/b&gt;&lt;br&gt;[OpenTelemetry, Jaeger, Prometheus, Loki, Grafana]&lt;br&gt;Traces, metrics and logs to find latency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="740" width="710" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="HTTPS" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="user" target="gateway">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="HTTP" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="gateway" target="auth">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="105"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="HTTP" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="gateway" target="catalog">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="HTTP" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;fontSize=10;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="gateway" target="telemetry">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="615"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="SQL" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="auth" target="authdb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="Read Home" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="catalog" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="Fallback" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;fontSize=10;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="catalog" target="mongo">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="Publish" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="telemetry" target="broker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="Consume" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="worker" target="broker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="Update state" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="worker" target="redis">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1135" y="295"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e11" value="Traces / metrics / logs" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#777777;fontSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="obs">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="780"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

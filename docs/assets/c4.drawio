        <mxCell id="tel_lbl" value="Traces / metrics / logs (OTLP) - every container exports to the stack" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;align=center;rotation=270;fontSize=10;" vertex="1" parent="1"><mxGeometry x="-168" y="770" width="460" height="20" as="geometry"/></mxCell>

<mxfile host="app.diagrams.net">
  <diagram id="c4-containers" name="C4 Level 2 - Containers (top-down)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1380" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;StreamHub VOD - Container Diagram (C4 Level 2)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontSize=18;" vertex="1" parent="1"><mxGeometry x="30" y="5" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="boundary" value="StreamHub VOD Platform [System]" style="rounded=0;dashed=1;fillColor=none;strokeColor=#444444;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="135" width="1440" height="1215" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Watches content, sends playback pings&lt;br&gt;and rates titles" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="600" y="25" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;Web App&lt;/b&gt;&lt;br&gt;[Container: Browser]&lt;br&gt;&lt;br&gt;Browse Home, play, like / dislike" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="320" y="185" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="mobile" value="&lt;b&gt;Mobile App&lt;/b&gt;&lt;br&gt;[Container: iOS / Android]&lt;br&gt;&lt;br&gt;Browse Home, play, like / dislike" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="620" y="185" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="tv" value="&lt;b&gt;SmartTV App&lt;/b&gt;&lt;br&gt;[Container: TV OS]&lt;br&gt;&lt;br&gt;Browse Home, play, like / dislike" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="920" y="185" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;[Container: Kong]&lt;br&gt;&lt;br&gt;Single entry point | Validates JWT | Resolves active subprofile | Routes requests | Adds X-Correlation-ID" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="120" y="335" width="1260" height="75" as="geometry"/></mxCell>
        <mxCell id="auth" value="&lt;b&gt;Auth &amp;amp; Profile Service&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;br&gt;Master accounts and family subprofiles&lt;br&gt;POST /auth/login, GET /profiles" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="150" y="500" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="catalog" value="&lt;b&gt;Catalog &amp;amp; Home Service&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;br&gt;Serves Home screen and catalog metadata&lt;br&gt;GET /home" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="500" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="telemetry" value="&lt;b&gt;Telemetry &amp;amp; Interactions Service&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;br&gt;Receives pings and likes, replies 202&lt;br&gt;POST /telemetry/ping, /interactions/like" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1060" y="500" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="authdb" value="&lt;b&gt;Auth DB&lt;/b&gt;&lt;br&gt;[PostgreSQL]&lt;br&gt;Accounts and subprofiles" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="700" width="200" height="108" as="geometry"/></mxCell>
        <mxCell id="redis" value="&lt;b&gt;Cache&lt;/b&gt;&lt;br&gt;[Redis]&lt;br&gt;Precomputed Home view&lt;br&gt;and Continue Watching" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="470" y="700" width="200" height="108" as="geometry"/></mxCell>
        <mxCell id="mongo" value="&lt;b&gt;Catalog DB&lt;/b&gt;&lt;br&gt;[MongoDB]&lt;br&gt;Movies and series metadata" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="750" y="700" width="200" height="108" as="geometry"/></mxCell>
        <mxCell id="broker" value="&lt;b&gt;Message Broker&lt;/b&gt;&lt;br&gt;[Container: RabbitMQ]&lt;br&gt;&lt;br&gt;Exchanges: streamhub.telemetry,&lt;br&gt;streamhub.interactions" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1060" y="700" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="wplay" value="&lt;b&gt;Playback Progress Worker&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;br&gt;Consumes ping events, persists progress,&lt;br&gt;updates Continue Watching" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="880" y="880" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="wdb" value="&lt;b&gt;Interactions DB&lt;/b&gt;&lt;br&gt;[Write-optimized NoSQL, e.g. Cassandra]&lt;br&gt;Source of truth: watch progress, likes, raw events&lt;br&gt;(Redis can be rebuilt from here)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1000" y="1050" width="400" height="115" as="geometry"/></mxCell>
        <mxCell id="wrec" value="&lt;b&gt;Recommendation Worker&lt;/b&gt;&lt;br&gt;[Container]&lt;br&gt;&lt;br&gt;Consumes rating events, persists them,&lt;br&gt;recalculates preferences" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1190" y="880" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="obs" value="&lt;b&gt;Observability Stack&lt;/b&gt;&lt;br&gt;[Container: OpenTelemetry Collector, Jaeger, Prometheus, Loki, Grafana]&lt;br&gt;&lt;br&gt;Traces, metrics and logs to find latency bottlenecks" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="120" y="1200" width="1260" height="85" as="geometry"/></mxCell>
        <mxCell id="e_uw" value="" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="web"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="125"/><mxPoint x="450" y="125"/></Array></mxGeometry></mxCell>
        <mxCell id="e_um" value="Uses" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="mobile"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_ut" value="" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="tv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="125"/><mxPoint x="1050" y="125"/></Array></mxGeometry></mxCell>
        <mxCell id="e_g_web" value="HTTPS / JSON" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2619;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="gateway"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>

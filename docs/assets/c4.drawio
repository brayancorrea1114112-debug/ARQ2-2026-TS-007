        <mxCell id="e_ga" value="HTTP" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.1429;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="auth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gc" value="HTTP" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.4683;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="catalog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_gt" value="HTTP" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.8651;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="telemetry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_adb" value="SQL" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="auth" target="authdb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_cr" value="Read Home" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="catalog" target="redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="645"/><mxPoint x="570" y="645"/></Array></mxGeometry></mxCell>
        <mxCell id="e_cm" value="Fallback (cache miss)" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="catalog" target="mongo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="645"/><mxPoint x="850" y="645"/></Array></mxGeometry></mxCell>
        <mxCell id="e_tb" value="Publish event" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#D97706;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="telemetry" target="broker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_wpb" value="Consume" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#D97706;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1333;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="wplay" target="broker"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="850"/><mxPoint x="1100" y="850"/></Array></mxGeometry></mxCell>
        <mxCell id="e_wrb" value="Consume" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#D97706;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrec" target="broker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_wpr" value="Update Continue Watching" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="wplay" target="redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="925"/></Array></mxGeometry></mxCell>
        <mxCell id="e_wrr" value="Update recommended rows" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.24;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrec" target="redis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="1010"/><mxPoint x="570" y="1010"/></Array></mxGeometry></mxCell>
        <mxCell id="e_wpd" value="Persist" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wplay" target="wdb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_wrd" value="Persist" style="endArrow=block;endFill=1;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;strokeColor=#333333;exitX=0.64;exitY=1;exitDx=0;exitDy=0;entryX=0.875;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrec" target="wdb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>

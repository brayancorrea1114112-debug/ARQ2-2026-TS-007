# Same-origin by default: Next rewrites /api/v1/* to Kong.
# Use an absolute URL only when the browser must call Kong directly.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-side Kong address used by the Next rewrite (never exposed to the browser).
KONG_INTERNAL_URL=http://localhost:8000

# false sends every request to Kong. true starts the MSW worker (offline demo).
NEXT_PUBLIC_USE_MOCKS=false

# Only used when NEXT_PUBLIC_USE_MOCKS=true.
# all: mock every endpoint (offline demo and the mock E2E suite).
NEXT_PUBLIC_MOCK_SCOPE=all

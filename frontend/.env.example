NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# true starts the MSW worker. Set it to false to send every request to Kong.
NEXT_PUBLIC_USE_MOCKS=true

# all: mock every endpoint (offline demo and E2E).
# missing: mock only telemetry and interactions; auth and home go to Kong.
NEXT_PUBLIC_MOCK_SCOPE=missing

# At least 32 characters. The same value in auth, catalog, telemetry and kong/kong.yml.
JWT_SECRET=CHANGE_ME
# The user and password of infra/mongo/.env. Encode special characters: * is %2A and + is %2B.
MONGODB_URI=mongodb://USER:PASSWORD@mongo:27017/streamhub?authSource=admin
REDIS_HOST=redis
REDIS_PORT=6379
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=streamhub

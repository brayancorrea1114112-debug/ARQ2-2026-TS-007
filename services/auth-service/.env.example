DB_URL=jdbc:postgresql://postgres:5432/auth
# The same values as infra/postgres/.env.
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# At least 32 characters. The same value in auth, catalog, telemetry and kong/kong.yml.
JWT_SECRET=CHANGE_ME
# Creates the development accounts (see SeedDataRunner).
SEED_ENABLED=true
SEED_PASSWORD=CHANGE_ME
MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
